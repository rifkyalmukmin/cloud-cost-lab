# ============================================================
# Cloud Cost Lab — environment configuration template
#
# Copy to .env and adjust locally:
#   cp .env.example .env
#
# NEVER commit the real .env. It is git-ignored on purpose.
# ============================================================

# --- Runtime mode -------------------------------------------------
# true  = mock/demo mode: synthetic billing + utilization data,
#         no GCP credentials required (default for Phase 1+ demos)
# false = real GCP data path (introduced in Phase 9)
DEMO_MODE=true

# --- Database (Phase 1: local PostgreSQL via docker compose) ------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloud_cost_lab
POSTGRES_USER=cloud_cost_lab
POSTGRES_PASSWORD=change-me-local-only

# --- Backend API (Phase 1: FastAPI) -------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend (Phase 2: Next.js) ----------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- GCP Billing Export (Phase 9 — leave empty in demo mode) ------
# Only set these when DEMO_MODE=false and billing export is enabled.
# GCP_BILLING_PROJECT=
# GCP_BILLING_DATASET=
# GCP_BILLING_TABLE=

# --- AI Advisor (Phase 16 — READ-ONLY advisor) --------------------
# pluggable provider; no AI calls happen in Phase 0-15
# AI_PROVIDER=none
# AI_API_KEY=
