# ============================================================
# Cloud Cost Lab — environment configuration template
#
# Copy to .env and adjust locally:
#   cp .env.example .env
#
# NEVER commit the real .env. It is git-ignored on purpose.
# ============================================================

# --- Runtime mode -------------------------------------------------
# true  = mock/demo mode: synthetic billing + utilization data,
#         no GCP credentials required (default for Phase 1+ demos)
# false = real GCP data path (introduced in Phase 9)
DEMO_MODE=true

# log level for the API (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# --- Database (Phase 1: local PostgreSQL via docker compose) ------
# POSTGRES_PORT/API_PORT are HOST-side ports; change them if another local
# project already uses these ports (container-internal ports stay fixed).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloud_cost_lab
POSTGRES_USER=cloud_cost_lab
POSTGRES_PASSWORD=change-me-local-only

# --- Backend API (Phase 1: FastAPI) -------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend (Phase 2: Next.js) ----------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Next.js inlines NEXT_PUBLIC_* at build time; restart `next dev` after changing it.

# --- Backend CORS (browser origins allowed to call the API) -------
# Comma-separated. The dashboard origin must be listed here.
CORS_ORIGINS=http://localhost:3000

# --- GCP Billing Export (Phase 8 — leave empty in demo mode) ------
# Only set these when DEMO_MODE=false and the billing export is enabled
# (docs/gcp-setup.md). Credentials come from Application Default
# Credentials or Workload Identity Federation — never key files.
# GCP_BILLING_PROJECT=
# GCP_BILLING_DATASET=
# GCP_BILLING_TABLE=
# GCP_BILLING_LOCATION=US
# GCP_BILLING_MAX_DAYS=92
# GCP_BILLING_MAX_ROWS=100000

# --- Data freshness (Phase 8, CLAUDE.md §41) -----------------------
# Max acceptable age of the newest data day before it is shown STALE.
FRESHNESS_MAX_HOURS=48

# --- AI Advisor (Phase 16 — READ-ONLY advisor) --------------------
# pluggable provider; no AI calls happen in Phase 0-15
# AI_PROVIDER=none
# AI_API_KEY=
