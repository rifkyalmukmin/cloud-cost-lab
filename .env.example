# Cloud Cost Lab — Environment Variables
# Copy this file to .env and fill in values

# Application Mode
DEMO_MODE=true
APP_ENV=development

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Database
DATABASE_URL=postgresql://cloudcost:cloudcost@localhost:5432/cloudcost
POSTGRES_USER=cloudcost
POSTGRES_PASSWORD=cloudcost
POSTGRES_DB=cloudcost

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# GCP (only needed when DEMO_MODE=false)
# GCP_PROJECT_ID=
# GCP_BILLING_PROJECT=
# GCP_BILLING_DATASET=
# GCP_BILLING_TABLE=
# GOOGLE_APPLICATION_CREDENTIALS=

# AI Advisor (optional)
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
